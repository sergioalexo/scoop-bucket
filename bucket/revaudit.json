{
    "$schema": "https://raw.githubusercontent.com/ScoopInstaller/Scoop/master/schema.json",
    "version": "1.0.1",
    "description": "Audits released Onshape assemblies for drawing and release gaps and checks production-file (DXF/SAT/PDF/STEP) coverage against a shop folder.",
    "homepage": "https://github.com/sergioalexo/revaudit",
    "license": "GPL-3.0-only",
    "depends": "python",
    "url": "https://github.com/sergioalexo/revaudit/archive/refs/tags/v1.0.1.tar.gz",
    "hash": "2b27d63364ffb6fa631e319a03d6b893969cd6b3cc0f2c077fd9f1942755214a",
    "extract_dir": "revaudit-1.0.1",
    "bin": [
        [
            "revaudit.py",
            "revaudit"
        ],
        [
            "serve.py",
            "revaudit-serve"
        ],
        [
            "oauth_app.py",
            "revaudit-oauth"
        ],
        [
            "launch.bat",
            "revaudit-launch"
        ],
        [
            "autostart.bat",
            "revaudit-autostart"
        ]
    ],
    "persist": [
        ".env",
        "revaudit.conf",
        "drawings",
        "reports"
    ],
    "pre_install": [
        "# Seed the config files BEFORE persist runs, otherwise Scoop persists them as directories.",
        "if (-not (Test-Path \"$dir\\.env\")) { Copy-Item \"$dir\\.env.example\" \"$dir\\.env\" }",
        "if (-not (Test-Path \"$dir\\revaudit.conf\")) { Copy-Item \"$dir\\revaudit.conf.example\" \"$dir\\revaudit.conf\" }"
    ],
    "post_install": [
        "# Persisted files exist now; point a still-blank `report =` at the persisted reports folder.",
        "$c = \"$dir\\revaudit.conf\"",
        "$t = Get-Content $c -Raw; if ($t -match '(?m)^\\s*report\\s*=\\s*\\r?$') { ($t -replace '(?m)^(\\s*report\\s*=).*', ('$1 ' + \"$persist_dir\\reports\")) | Set-Content -NoNewline $c }"
    ],
    "notes": [
        "Put your Onshape API key in .env and set folders / port in revaudit.conf.",
        "Both are kept across updates by Scoop.  Open the folder:  scoop prefix revaudit",
        "Run:  revaudit-serve  (web UI)   |   revaudit <ASM number>  (CLI)",
        "Start with Windows:  revaudit-autostart on   (off / status)"
    ],
    "checkver": {
        "url": "https://api.github.com/repos/sergioalexo/revaudit/tags",
        "regex": "\"name\":\\s*\"v([\\d.]+)\""
    },
    "autoupdate": {
        "url": "https://github.com/sergioalexo/revaudit/archive/refs/tags/v$version.tar.gz",
        "extract_dir": "revaudit-$version"
    }
}
